{
  "name": "elektronikmart-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev -p 3000",
    "dev:api": "npm run dev --prefix server",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:reviews": "npm run seed:reviews --prefix server",
    "seed:flash-sale": "npm run seed:flash-sale --prefix server"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.383.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.2"
  }
}
